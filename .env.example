# 复制为 .env 后按需修改；不要把真实密钥提交到仓库。

# ---------- 推理后端（四选一）----------
# mock    离线确定性后端：无 GPU、无网络也能跑通全链路（默认，用于 CI 与演示）
# ollama  本地离线单机：涉密数据不出机、零运维
# vllm    生产级并发：OpenAI 兼容接口 + PagedAttention + 连续批处理
# openai  云端 API
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODEL=
EMBED_MODEL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---------- 检索 ----------
USE_HYBRID=true          # 向量 + BM25 双路召回
USE_RERANK=true          # 交叉编码器/启发式重排
RECALL_K=20              # 召回条数（重排前的候选池）
TOP_K=5                  # 最终进入上下文的条数
RRF_K=60                 # RRF 平滑常数
RERANK_METHOD=heuristic  # heuristic | llm
MAX_CONTEXT_CHARS=6000
# 召回置信度闸门：首位候选的「词项覆盖率」低于该值 → 直接拒答。
# 0.30 取自金标集实测分离区间 (0.2121, 0.5484] 的中部，两侧均有余量。
# 设为 0 关闭该闸门（此时「无依据问题」会被强行作答，评测中的应拒答用例会失败）。
# 标定工具：python scripts/diagnose_coverage.py
MIN_TOP_COVERAGE=0.30
LAYER_PRIOR=L1=1.00,L2=0.96,L3=0.90,L4=0.84

# ---------- 治理 ----------
SERVICE_API_KEY=          # 留空则不鉴权；生产务必设置
RATE_LIMIT_PER_MIN=60

# ---------- 可观测性 ----------
ENABLE_LANGFUSE=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 路径（容器内默认已正确，一般无需修改）----------
KNOWLEDGE_DIR=data/knowledge
INDEX_DIR=data/index
TRACE_DIR=data/traces
WORKSPACE_DIR=data/workspace
